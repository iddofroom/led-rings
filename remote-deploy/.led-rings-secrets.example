# led-rings host — SECRETS.  Copy this file to  .led-rings-secrets  (same folder) and fill in
# the real value.  .led-rings-secrets is gitignored and must NEVER be committed or shared publicly.
#
# Cloudflare Tunnel token for this device's public URL — get it from the website
# ("Set up the Raspberry Pi") or the tunnel owner, over a secure channel (password manager /
# Signal / one-time-secret link), not from email or chat groups.
TUNNEL_TOKEN=

# Public URL this device serves on. Blank = the shared default (kivsee.iddofroom.co.il).
# For a per-device tunnel, set the unique subdomain the website issued you, e.g.
#   PUBLIC_URL=https://myinstall.kivsee.iddofroom.co.il
# (The .img first-boot provisioner writes this automatically from ledrings-config.txt.)
PUBLIC_URL=

# Clerk publishable key for the login (the iddofroom.co.il instance). This one is PUBLIC (it ends
# up in the built app), so it's fine to paste here — it just needs to match the Worker's instance.
VITE_CLERK_PUBLISHABLE_KEY=
