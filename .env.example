# Copy this file to  .env  and fill in real values.  .env is gitignored — never commit real keys.

# Kivsee LED backend service endpoints. If the services run on THIS machine, leave 127.0.0.1.
LEDS_OBJECT_SERVICE_IP=127.0.0.1
SEQUENCE_SERVICE_IP=127.0.0.1
TRIGGER_SERVICE_IP=127.0.0.1

# Google Gemini API key (AI composition). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown):
# LEDS_OBJECT_SERVICE_PORT=8081
# SEQUENCE_SERVICE_PORT=8082
# TRIGGER_SERVICE_PORT=8083
# NUMBER_OF_RINGS=12
# CONTROL_SERVER_PORT=3080
