# Copy to ui/.env for local development (ui/.env is gitignored).

# Control server (LED playback API). Point at your local control-server port.
VITE_API_URL=http://localhost:8088

# Clerk publishable key (the shared iddofroom.co.il instance). Public by design — it's baked into
# the built bundle. Required both locally and in the friend's Pi build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Cloud song library (Cloudflare KV via the leds-frontdoor Worker).
# Local dev uses the absolute Worker URL so it shares the live cloud library.
# In the production build (served through the Worker) leave this UNSET — calls go same-origin.
VITE_LIBRARY_URL=https://leds.iddofroom.co.il

# The leds subdomain is behind Clerk. Local dev can't send the Clerk cookie cross-origin, so paste
# the Worker's LIBRARY_API_KEY secret here to reach the (gated) library from localhost as a
# superuser. Leave EMPTY in the production build — prod authenticates with the Clerk session.
VITE_LIBRARY_KEY=
