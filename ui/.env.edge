# Edge (Cloudflare Workers) build — the app is served at the public hostname and talks to the
# API same-origin (/api/*, proxied by the Worker to the Pi). VITE_API_URL MUST stay empty here:
# this mode file overrides a developer's local ui/.env, so a dev value like
# http://localhost:8088 can never leak into the deployed bundle again.
VITE_API_URL=
